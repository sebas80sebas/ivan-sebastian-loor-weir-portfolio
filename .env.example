# Build-time configuration. This project needs NO secrets.
#
# SITE_URL (public): absolute URL where the site is served. Used for canonical
# URLs, hreflang, Open Graph and the sitemap. It is printed into every page,
# so it is not sensitive. Defaults to the Cloudflare Pages URL if unset.
SITE_URL=https://ivan-sebastian-loor-weir-portfolio.pages.dev
