---
/**
 * <head> metadata: title, description, canonical, hreflang alternates,
 * Open Graph / Twitter cards and JSON-LD structured data.
 */
import { site } from '@/config/site';
import { languages, defaultLang, type Lang } from '@/i18n/ui';
import { alternates } from '@/i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: object;
  noindex?: boolean;
}

const { title, description, lang, image = site.ogImage, type = 'website', jsonLd, noindex = false } = Astro.props;
const siteUrl = Astro.site!;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const alts = alternates(Astro.url);
const ogImage = new URL(image, siteUrl).href;
const otherLocales = (Object.keys(languages) as Lang[]).filter((l) => l !== lang);
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
{
  !noindex &&
    (Object.keys(alts) as Lang[]).map((l) => (
      <link rel="alternate" hreflang={languages[l].htmlLang} href={new URL(alts[l], siteUrl).href} />
    ))
}
{!noindex && <link rel="alternate" hreflang="x-default" href={new URL(alts[defaultLang], siteUrl).href} />}

<meta name="author" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${site.jobTitle[lang]}`} />
<meta property="og:locale" content={languages[lang].ogLocale} />
{otherLocales.map((l) => <meta property="og:locale:alternate" content={languages[l].ogLocale} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
