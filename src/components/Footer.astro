---
import Monogram from './Monogram.astro';
import Icon from './Icon.astro';
import { site } from '@/config/site';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <span class="site-footer__mark"><Monogram size={40} variant="bare" /></span>
      <div>
        <p class="site-footer__name">{site.name}</p>
        <p class="site-footer__role">{site.jobTitle[lang]} · {site.positioning}</p>
      </div>
    </div>

    <ul class="site-footer__links" role="list">
      <li>
        <a href={`mailto:${site.contact.email}`}><Icon name="mail" /> {site.contact.email}</a>
      </li>
      <li>
        <a href={site.contact.linkedin} target="_blank" rel="noopener noreferrer">
          <Icon name="linkedin" /> LinkedIn <span class="sr-only">{t('common.newTab')}</span>
        </a>
      </li>
      <li>
        <a href={site.contact.github} target="_blank" rel="noopener noreferrer">
          <Icon name="github" /> GitHub <span class="sr-only">{t('common.newTab')}</span>
        </a>
      </li>
    </ul>

    <div class="site-footer__meta">
      <p>© {year} {site.name}. {t('footer.rights')}</p>
      <p>{t('footer.built')}</p>
      <a class="site-footer__top" href="#top">
        <Icon name="arrow-up" size={16} /> {t('footer.top')}
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink-bg);
    color: var(--ink-muted);
    padding-block: var(--space-8) var(--space-6);
    font-size: var(--step--1);
  }
  .site-footer__inner {
    display: grid;
    gap: var(--space-6);
  }
  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .site-footer__mark {
    color: var(--ink-text);
  }
  .site-footer__mark :global(.monogram__node) {
    fill: var(--ink-accent);
  }
  .site-footer__name {
    color: var(--ink-text);
    font-weight: 600;
    font-size: var(--step-0);
  }
  .site-footer__role {
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    list-style: none;
    padding: var(--space-5) 0;
    border-block: 1px solid var(--ink-line);
  }
  .site-footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-text);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--ink-accent);
  }
  .site-footer a:focus-visible {
    outline-color: var(--ink-accent);
  }
  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    align-items: center;
  }
  .site-footer__top {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }
  @media (max-width: 40rem) {
    .site-footer__top {
      margin-left: 0;
    }
  }
</style>
