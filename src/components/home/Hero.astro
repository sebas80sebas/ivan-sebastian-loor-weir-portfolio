---
import Icon from '@/components/Icon.astro';
import HeroVisual from './HeroVisual.astro';
import { site } from '@/config/site';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { availableCvs, cvRequestHref } from '@/lib/cv';

interface Props {
  lang: Lang;
  certCount: number;
}
const { lang, certCount } = Astro.props;
const t = useTranslations(lang);
const cv = availableCvs(lang)[0];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow">
        <span class="hero__pulse" aria-hidden="true"></span>
        {t('hero.eyebrow')}
      </p>
      <h1 id="hero-title" class="hero__name">{site.name}</h1>
      <p class="hero__statement">
        {t('hero.statement.a')} <em>{t('hero.statement.em')}</em>{t('hero.statement.b').startsWith(':') ? '' : ' '}{t('hero.statement.b')}
      </p>
      <p class="hero__positioning">{site.positioning}</p>

      <div class="hero__ctas">
        <a class="btn btn--accent" href="#projects">
          {t('hero.cta.primary')} <Icon name="arrow-down" />
        </a>
        {
          cv ? (
            <a class="btn btn--on-ink" href={cv.href} download>
              <Icon name="download" /> {t('cv.download')}
            </a>
          ) : (
            <a class="btn btn--on-ink" href={cvRequestHref(t('cv.requestSubject'))}>
              <Icon name="file" /> {t('cv.request')}
            </a>
          )
        }
        <a class="btn btn--on-ink btn--icon" href={site.contact.linkedin} target="_blank" rel="noopener noreferrer">
          <Icon name="linkedin" label="LinkedIn" />
          <span class="sr-only">{t('common.newTab')}</span>
        </a>
        <a class="btn btn--on-ink btn--icon" href={site.contact.github} target="_blank" rel="noopener noreferrer">
          <Icon name="github" label="GitHub" />
          <span class="sr-only">{t('common.newTab')}</span>
        </a>
      </div>

      <p class="hero__location"><Icon name="pin" size={16} /> {site.location[lang]}</p>
    </div>

    <div class="hero__visual">
      <HeroVisual lang={lang} />
    </div>
  </div>

  <div class="container">
    <dl class="hero__facts" aria-label={t('hero.facts.label')}>
      <div class="hero__fact">
        <dt>{t('hero.fact.envs.value')}</dt>
        <dd>{t('hero.fact.envs.label')}</dd>
      </div>
      <div class="hero__fact">
        <dt>{t('hero.fact.services.value')}</dt>
        <dd>{t('hero.fact.services.label')}</dd>
      </div>
      <div class="hero__fact">
        <dt>{certCount}</dt>
        <dd>{t('hero.fact.certs.label')}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--ink-bg);
    color: var(--ink-text);
    padding-block: clamp(3rem, 2rem + 5vw, 6.5rem) var(--space-7);
    background-image:
      radial-gradient(48rem 28rem at 80% 10%, rgba(79, 209, 224, 0.13), transparent 60%),
      radial-gradient(40rem 26rem at 0% 100%, rgba(124, 157, 255, 0.1), transparent 60%),
      linear-gradient(rgba(233, 237, 243, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(233, 237, 243, 0.035) 1px, transparent 1px);
    background-size: auto, auto, 32px 32px, 32px 32px;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--ink-line);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    background: rgba(16, 26, 41, 0.6);
  }
  .hero__pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4cc38a;
    box-shadow: 0 0 0 0 rgba(76, 195, 138, 0.6);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    70% { box-shadow: 0 0 0 8px rgba(76, 195, 138, 0); }
    100% { box-shadow: 0 0 0 0 rgba(76, 195, 138, 0); }
  }
  .hero__name {
    margin-top: var(--space-5);
    font-size: var(--step-5);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }
  .hero__statement {
    margin-top: var(--space-5);
    max-width: 34ch;
    font-family: var(--font-serif);
    font-size: var(--step-3);
    line-height: 1.18;
    letter-spacing: -0.005em;
    color: var(--ink-text);
  }
  .hero__statement em {
    font-style: italic;
    color: var(--ink-accent);
  }
  .hero__positioning {
    margin-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .btn--icon {
    width: 2.9rem;
    padding: 0;
  }
  .hero .btn:focus-visible {
    outline-color: var(--ink-accent);
  }
  .hero__location {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: var(--space-5);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(3rem, 2rem + 4vw, 5.5rem);
    border-top: 1px solid var(--ink-line);
  }
  .hero__fact {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-5) 0 0;
  }
  .hero__fact + .hero__fact {
    padding-left: var(--space-5);
    border-left: 1px solid var(--ink-line);
  }
  .hero__fact dt {
    font-family: var(--font-serif);
    font-size: var(--step-4);
    line-height: 1;
    color: var(--ink-accent);
  }
  .hero__fact dd {
    margin: 0;
    max-width: 22ch;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink-muted);
  }

  @media (max-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__visual {
      max-width: 36rem;
    }
  }
  @media (max-width: 42rem) {
    .hero__facts {
      grid-template-columns: 1fr;
    }
    .hero__fact,
    .hero__fact + .hero__fact {
      padding: var(--space-4) 0;
      border-left: 0;
      border-bottom: 1px solid var(--ink-line);
    }
  }
</style>
