---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import SectionHeader from '@/components/SectionHeader.astro';
import Icon from '@/components/Icon.astro';
import portrait from '@/assets/profile.jpg';
import { site } from '@/config/site';
import type { Lang } from '@/i18n/ui';
import { l, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  index: number;
}
const { lang, index } = Astro.props;
const t = useTranslations(lang);
const profile = (await getEntry('profile', 'about'))!.data;
---
<section id="about" class="section about" aria-labelledby="about-title">
  <div class="container">
    <SectionHeader
      id="about-title"
      index={index}
      label={t('section.about')}
      title={t('about.title.a')}
      em={t('about.title.em')}
    />

    <div class="about__grid">
      <div class="about__aside" data-reveal>
        <div class="about__portrait">
          <Image
            src={portrait}
            alt={site.name}
            widths={[320, 480, 640]}
            sizes="(max-width: 48rem) 70vw, 22rem"
            format="webp"
            quality={78}
            loading="lazy"
          />
        </div>
        <dl class="about__facts">
          <div>
            <dt class="label">{t('about.facts.location')}</dt>
            <dd><Icon name="pin" size={15} /> {site.location[lang]}</dd>
          </div>
          <div>
            <dt class="label">{t('about.facts.languages')}</dt>
            <dd>
              <ul role="list">
                {
                  profile.languages.map((x) => (
                    <li>
                      <strong>{l(x.name, lang)}</strong> — {l(x.level, lang)}
                      {x.credential && x.url && (
                        <a class="text-link about__cred" href={x.url} target="_blank" rel="noopener noreferrer">
                          {l(x.credential, lang)}
                          <span class="sr-only">{t('common.newTab')}</span>
                        </a>
                      )}
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
          <div>
            <dt class="label">{t('about.facts.focus')}</dt>
            <dd>{l(profile.focus, lang)}</dd>
          </div>
        </dl>
      </div>

      <div class="about__body">
        <div class="about__prose" data-reveal>
          {profile.paragraphs[lang].map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
        </div>

        <div class="about__principles" data-reveal>
          <h3 class="label">{t('about.principles')}</h3>
          <ol role="list">
            {
              profile.principles[lang].map((p, i) => (
                <li>
                  <span class="about__pn">{String(i + 1).padStart(2, '0')}</span>
                  <span>{p}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .about__portrait {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: var(--border);
    background: var(--surface-2);
    aspect-ratio: 1;
  }
  .about__portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(14, 23, 38, 0.06);
    pointer-events: none;
  }
  .about__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about__facts {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }
  .about__facts > div {
    padding-top: var(--space-4);
    border-top: var(--border);
  }
  .about__facts dd {
    margin: 0.35rem 0 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .about__facts ul {
    display: grid;
    gap: 0.25rem;
  }
  .about__facts strong {
    font-weight: 600;
    color: var(--ink);
  }
  .about__cred {
    display: block;
    font-size: var(--step--2);
  }
  .about__prose {
    display: grid;
    gap: var(--space-5);
    max-width: 62ch;
  }
  .about__prose p:not(.lead) {
    color: var(--ink-2);
  }
  .about__principles {
    margin-top: var(--space-7);
    padding: var(--space-5) var(--space-6);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .about__principles ol {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-4);
  }
  .about__principles li {
    display: flex;
    gap: var(--space-3);
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .about__pn {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--accent);
    padding-top: 0.2em;
  }
  @media (max-width: 52rem) {
    .about__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .about__aside {
      display: grid;
      grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
      gap: var(--space-5);
      align-items: start;
    }
    .about__facts {
      margin-top: 0;
    }
  }
  @media (max-width: 36rem) {
    .about__aside {
      grid-template-columns: 1fr;
    }
    .about__portrait {
      max-width: 14rem;
    }
    .about__principles ol {
      grid-template-columns: 1fr;
    }
  }
</style>
