---
import { getCollection } from 'astro:content';
import SectionHeader from '@/components/SectionHeader.astro';
import type { Lang } from '@/i18n/ui';
import { l, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  index: number;
}
const { lang, index } = Astro.props;
const t = useTranslations(lang);
const domains = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const contexts = ['professional', 'academic', 'personal', 'certified'] as const;
---
<section id="skills" class="section skills" aria-labelledby="skills-title">
  <div class="container">
    <SectionHeader
      id="skills-title"
      index={index}
      label={t('section.skills')}
      title={t('skills.title')}
      intro={t('skills.intro')}
    />

    <ul class="skills__legend" role="list" data-reveal>
      {
        contexts.map((c) => (
          <li class={`ctx ctx--${c}`}>{t(`skills.context.${c}`)}</li>
        ))
      }
    </ul>

    <div class="skills__grid">
      {
        domains.map(({ data: d }, i) => (
          <section class="domain" aria-labelledby={`skill-${i}`} data-reveal>
            <header class="domain__head">
              <span class="domain__n mono">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 id={`skill-${i}`} class="domain__title">{l(d.title, lang)}</h3>
                <p class="domain__summary">{l(d.summary, lang)}</p>
              </div>
            </header>
            <dl class="domain__items">
              {d.items.map((item) => (
                <div class="skill">
                  <dt class="skill__name">
                    <span>{item.name}</span>
                    <span class="skill__ctx">
                      {item.context.map((c) => (
                        <span class={`ctx ctx--${c}`}>{t(`skills.context.${c}`)}</span>
                      ))}
                    </span>
                  </dt>
                  <dd class="skill__usage">{l(item.usage, lang)}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  .ctx {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .ctx--professional {
    color: var(--accent);
    background: var(--accent-soft);
  }
  .ctx--academic {
    color: var(--signal);
    background: var(--signal-soft);
  }
  .ctx--personal {
    color: var(--warn);
    background: color-mix(in srgb, var(--warn) 12%, transparent);
  }
  .ctx--certified {
    color: var(--ok);
    background: color-mix(in srgb, var(--ok) 12%, transparent);
  }
  .skills__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .domain {
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .domain__head {
    display: flex;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: var(--border);
  }
  .domain__n {
    font-size: var(--step--2);
    color: var(--accent);
    padding-top: 0.35em;
  }
  .domain__title {
    font-size: var(--step-1);
  }
  .domain__summary {
    margin-top: 0.3rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .domain__items {
    display: grid;
  }
  .skill {
    padding-block: var(--space-4);
  }
  .skill + .skill {
    border-top: 1px dashed var(--line);
  }
  .skill__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem var(--space-3);
    font-weight: 600;
    font-size: var(--step--1);
  }
  .skill__ctx {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .skill__usage {
    margin: 0.35rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-2);
    line-height: 1.55;
  }
  @media (max-width: 56rem) {
    .skills__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
