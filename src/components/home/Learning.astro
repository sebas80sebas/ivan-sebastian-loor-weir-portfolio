---
import { getCollection } from 'astro:content';
import SectionHeader from '@/components/SectionHeader.astro';
import type { Lang } from '@/i18n/ui';
import { l, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  index: number;
}
const { lang, index } = Astro.props;
const t = useTranslations(lang);
const all = (await getCollection('learning')).sort((a, b) => a.data.order - b.data.order);
const focus = all.filter((x) => x.data.kind === 'focus');
const courses = all.filter((x) => x.data.kind === 'course');
const providers = [...new Set(courses.map((c) => c.data.provider ?? ''))];
---
<section id="learning" class="section learning" aria-labelledby="learning-title">
  <div class="container">
    <SectionHeader
      id="learning-title"
      index={index}
      label={t('section.learning')}
      title={t('learning.title')}
      intro={t('learning.intro')}
    />

    <div class="learning__grid">
      <div data-reveal>
        <h3 class="label learning__h">{t('learning.focus')}</h3>
        <ol class="focus" role="list">
          {
            focus.map(({ data: f }, i) => (
              <li class="focus__item">
                <span class="focus__n mono">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <p class="focus__title">{l(f.title, lang)}</p>
                  {f.description && <p class="focus__desc">{l(f.description, lang)}</p>}
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="courses card" data-reveal>
        <h3 class="label learning__h">{t('learning.courses')}</h3>
        <p class="courses__note">{t('learning.coursesNote')}</p>
        {
          providers.map((p) => (
            <div class="courses__group">
              <p class="courses__provider mono">{p}</p>
              <ul role="list">
                {courses
                  .filter((c) => c.data.provider === p)
                  .map(({ data: c }) => (
                    <li>{l(c.title, lang)}</li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .learning__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }
  .learning__h {
    margin-bottom: var(--space-4);
  }
  .focus {
    display: grid;
  }
  .focus__item {
    display: flex;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: var(--border);
  }
  .focus__n {
    font-size: var(--step--2);
    color: var(--accent);
    padding-top: 0.3em;
  }
  .focus__title {
    font-weight: 600;
  }
  .focus__desc {
    margin-top: 0.25rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .courses {
    padding: var(--space-5) var(--space-6);
  }
  .courses .learning__h {
    margin-bottom: var(--space-2);
  }
  .courses__note {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .courses__group {
    margin-top: var(--space-5);
  }
  .courses__provider {
    font-size: var(--step--2);
    color: var(--ink);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .courses__group ul {
    display: grid;
    gap: 0.35rem;
    margin-top: var(--space-2);
  }
  .courses__group li {
    display: flex;
    gap: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .courses__group li::before {
    content: '';
    flex: none;
    width: 5px;
    height: 5px;
    margin-top: 0.6em;
    border-radius: 50%;
    background: var(--line-strong);
  }
  @media (max-width: 52rem) {
    .learning__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
