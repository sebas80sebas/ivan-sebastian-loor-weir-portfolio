---
/**
 * ISLW monogram — a 2×2 letter grid: "IS" in warm white over "LW" in cyan.
 * The same geometry is used for the favicon (public/favicon.svg), the app
 * icons, the social preview image (scripts/og/og-image.html) and the site
 * logo, so the brand mark stays consistent everywhere. Keep them in sync.
 */
interface Props {
  size?: number;
  /** "tile" renders the brand tile (fixed brand colours); "bare" renders letters only. */
  variant?: 'tile' | 'bare';
  title?: string;
  class?: string;
}
const { size = 36, variant = 'tile', title, class: className } = Astro.props;
---
<svg
  class:list={['monogram', `monogram--${variant}`, className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  focusable="false"
>
  {
    variant === 'tile' && (
      <>
        <rect width="64" height="64" rx="14" class="monogram__tile" />
        <rect x=".75" y=".75" width="62.5" height="62.5" rx="13.25" class="monogram__edge" />
      </>
    )
  }
  <g fill="none" stroke-width="5.6" stroke-linejoin="round">
    <g class="monogram__primary">
      <path d="M19.5 12.5V29.5" />
      <path d="M48 13.3H39.6a4.1 4.1 0 0 0 0 8.2h4.3a4.1 4.1 0 0 1 0 8.2H35" />
    </g>
    <g class="monogram__accent">
      <path d="M17 34.5V51.5H29" />
      <path d="M33.4 34.5l3.7 17 4-11 4 11 3.7-17" />
    </g>
  </g>
</svg>

<style>
  .monogram {
    flex: none;
  }
  /* The tile keeps brand colours in both themes. */
  .monogram__tile {
    fill: #101a2b;
  }
  .monogram__edge {
    fill: none;
    stroke: rgba(255, 255, 255, 0.12);
    stroke-width: 1.5;
  }
  .monogram--tile .monogram__primary {
    stroke: #f4f2ec;
  }
  .monogram--tile .monogram__accent {
    stroke: #4fd1e0;
  }
  .monogram--bare .monogram__primary {
    stroke: currentColor;
  }
  .monogram--bare .monogram__accent {
    stroke: var(--monogram-accent, var(--accent-bright));
  }
</style>
